<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>Quarry</PackageId>
    <Description>Type-safe SQL builder and query reader for .NET 10 with AOT support</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeSource>$(MSBuildThisFileDirectory)../../README.md</PackageReadmeSource>

    <!-- Logsmith: Abstraction mode for zero-dependency logging -->
    <LogsmithMode>Abstraction</LogsmithMode>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quarry.Tests" />
    <InternalsVisibleTo Include="Quarry.IntegrationTests" />
    <InternalsVisibleTo Include="Quarry.Benchmarks" />
    <InternalsVisibleTo Include="Quarry.Generator" />
    <InternalsVisibleTo Include="Quarry.Tool" />
    <InternalsVisibleTo Include="Quarry.Sample.WebApp" />
    <InternalsVisibleTo Include="Quarry.Sample.Aot" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Logsmith" Version="0.5.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship build targets so the Quarry.Generated interceptors namespace
       is registered automatically on consumer projects. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Shared project (compiled into this assembly) -->
  <Import Project="..\Quarry.Shared\Quarry.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <Compile Remove="..\Quarry.Shared\Migration\**\*.cs" />
    <Compile Remove="..\Quarry.Shared\Scaffold\**\*.cs" />
    <Compile Remove="..\Quarry.Shared\Sql\Parser\**\*.cs" />
  </ItemGroup>

  <!-- Migration model types are single-sourced from Quarry.Shared; QUARRY_RUNTIME gates them
       into the public Quarry.Migration namespace here (generator/tool compile the same files
       as Quarry.Shared.Migration). See #313. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);QUARRY_RUNTIME</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Quarry.Shared\Migration\Models\ColumnDef.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\ColumnKind.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\ForeignKeyAction.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\ForeignKeyDef.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\IndexDef.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\NamingStyleKind.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\SchemaSnapshot.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Models\TableDef.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Builders\ColumnDefBuilder.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Builders\TableDefBuilder.cs" LinkBase="Shared" />
    <Compile Include="..\Quarry.Shared\Migration\Builders\SchemaSnapshotBuilder.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildingDocs)' != 'true'">
    <ProjectReference Include="../Quarry.Generator/Quarry.Generator.csproj"
                      IncludeAssets="analyzers"
                      PrivateAssets="none" />
  </ItemGroup>

</Project>
